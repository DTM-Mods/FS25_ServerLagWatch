# --- DTM standard (the same in every DTM-Mods repository) ---
# builds and downloads
dist/
*.zip
# Python
__pycache__/
*.pyc
/venv/
# logs, backups, editor and system files
*.log
*.bak
*backup*/
*Backup*/
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
# Blender and other 3D work files: big, and the game doesn't load them (keep them outside git)
*.blend
*.blend[0-9]
*.obj
*.mtl
# --- end of the DTM standard; this repository's own rules follow ---
